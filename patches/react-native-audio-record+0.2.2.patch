+/*
+  통화 훈련은 상대 음성 재생과 마이크 입력이 동시에 돌아간다.
+  업스트림이 쓰는 Record 카테고리는 재생을 끊고 에코도 잡지 못하므로
+  PlayAndRecord + VoiceChat 모드로 iOS 내장 에코 캔슬링을 켠다.
+*/
+- (void)applyAecVoiceChatMode {
+    AVAudioSession *session = [AVAudioSession sharedInstance];
+    if (!session) return;
+
+    NSError *categoryError = nil;
+    if (![session setCategory:AVAudioSessionCategoryPlayAndRecord
+                  withOptions:(AVAudioSessionCategoryOptionDefaultToSpeaker |
+                               AVAudioSessionCategoryOptionAllowBluetooth)
+                        error:&categoryError]) {
+        RCTLogInfo(@"[AEC] setCategory 실패: %@", categoryError);
+    }
+
+    NSError *modeError = nil;
+    if (![session setMode:AVAudioSessionModeVoiceChat error:&modeError]) {
+        RCTLogInfo(@"[AEC] setMode 실패: %@", modeError);
+    }
+
+    NSError *activeError = nil;
+    if (![session setActive:YES error:&activeError]) {
+        RCTLogInfo(@"[AEC] setActive 실패: %@", activeError);
+    }
+}
