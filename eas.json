{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FIREBASE_PUSH_ENABLED": "true"
      }
    },
    "preview": {
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spring.chickenmayo.kr",
        "EXPO_PUBLIC_AI_API_URL": "https://fastapi.chickenmayo.kr",
        "EXPO_PUBLIC_FIREBASE_PUSH_ENABLED": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spring.chickenmayo.kr",
        "EXPO_PUBLIC_AI_API_URL": "https://fastapi.chickenmayo.kr",
        "EXPO_PUBLIC_FIREBASE_PUSH_ENABLED": "true"
      }
    },
    "onestore": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "onestore",
        "EXPO_PUBLIC_API_URL": "https://spring.chickenmayo.kr",
        "EXPO_PUBLIC_AI_API_URL": "https://fastapi.chickenmayo.kr",
        "EXPO_PUBLIC_FIREBASE_PUSH_ENABLED": "true"
      }
    },
    "playstore": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "playstore",
        "EXPO_PUBLIC_API_URL": "https://spring.chickenmayo.kr",
        "EXPO_PUBLIC_AI_API_URL": "https://fastapi.chickenmayo.kr",
        "EXPO_PUBLIC_FIREBASE_PUSH_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
