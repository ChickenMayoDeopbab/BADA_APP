  "components": {
    "schemas": {
      "GoodSegment": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "format": "double"
          },
          "end": {
            "type": "number",
            "format": "double"
          },
          "good_point": {
            "type": "string"
          }
        }
      },
      "SessionClosedRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "SCENARIO_DONE",
              "USER_END",
              "TIMEOUT",
              "CRISIS",
              "END_CALL",
              "NO_AUDIO",
              "ERROR"
            ]
          },
          "transcript": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptTurn"
            }
          },
          "silence_total": {
            "type": "number",
            "format": "double"
          },
          "shake_count": {
            "type": "integer",
            "format": "int32"
          },
          "good_segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoodSegment"
            }
          },
          "recording_key": {
            "type": "string"
          }
        }
      },
      "TranscriptTurn": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ApiResponseSessionClosedResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/SessionClosedResponse"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionClosedResponse": {
        "type": "object",
        "properties": {
          "silence_total": {
            "type": "number",
            "format": "double"
          },
          "shake_count": {
            "type": "integer",
            "format": "int32"
          },
          "good_segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoodSegment"
            }
          }
        }
      },
      "RecordAnxietyScoreRequest": {
        "required": [
          "score"
        ],
        "type": "object",
        "properties": {
          "score": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AnxietyScoreResponse": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "integer",
            "format": "int64"
          },
          "sessionId": {
            "type": "string"
          },
          "anxietyScore": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ApiResponseAnxietyScoreResponse": {
        "type": "object",
